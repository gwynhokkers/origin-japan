{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "origin-japan",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "origin-japan"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "origin-japan-media"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
