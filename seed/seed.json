{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "collections": [
    {
      "slug": "vehicles",
      "label": "Vehicles",
      "labelSingular": "Vehicle",
      "icon": "car",
      "routable": true,
      "urlPattern": "/listings/{slug}",
      "fields": [
        {
          "slug": "availability",
          "label": "Availability",
          "type": "select",
          "translatable": false,
          "validation": {
            "options": ["In prep", "On water", "Sold"]
          }
        },
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "searchable": true,
          "translatable": false
        },
        {
          "slug": "make",
          "label": "Make",
          "type": "string",
          "searchable": true,
          "translatable": false
        },
        {
          "slug": "model",
          "label": "Model",
          "type": "string",
          "searchable": true,
          "translatable": false
        },
        {
          "slug": "body",
          "label": "Body",
          "type": "select",
          "translatable": false,
          "validation": {
            "options": ["Convertible", "Pickup", "Coupe", "MPV", "Hatchback", "Estate"]
          }
        },
        {
          "slug": "year",
          "label": "Year",
          "type": "integer",
          "translatable": false,
          "validation": { "min": 1900, "max": 2100 }
        },
        {
          "slug": "transmission",
          "label": "Transmission",
          "type": "select",
          "translatable": false,
          "validation": {
            "options": ["Manual", "Automatic", "DSG"]
          }
        },
        {
          "slug": "mileage",
          "label": "Mileage",
          "type": "integer",
          "translatable": false,
          "validation": { "min": 0 }
        },
        {
          "slug": "price",
          "label": "Price",
          "type": "integer",
          "translatable": false,
          "validation": { "min": 1 }
        },
        {
          "slug": "photos",
          "label": "Photos",
          "type": "repeater",
          "translatable": false,
          "validation": {
            "subFields": [
              { "slug": "photo", "label": "Photo", "type": "image", "required": true }
            ]
          }
        },
        {
          "slug": "sellers_notes",
          "label": "Seller's notes",
          "type": "text",
          "searchable": true,
          "translatable": false
        },
        {
          "slug": "vin",
          "label": "VIN",
          "type": "string",
          "translatable": false
        },
        {
          "slug": "order",
          "label": "Order",
          "type": "integer",
          "translatable": false
        }
      ]
    },
    {
      "slug": "leads",
      "label": "Leads",
      "labelSingular": "Lead",
      "icon": "envelope",
      "routable": false,
      "titleField": "vehicle",
      "admin": {
        "listColumns": ["first_name", "email"]
      },
      "fields": [
        {
          "slug": "vehicle",
          "label": "Vehicle",
          "type": "string",
          "required": true,
          "searchable": true,
          "translatable": false
        },
        {
          "slug": "first_name",
          "label": "First name",
          "type": "string",
          "required": true,
          "searchable": true,
          "translatable": false
        },
        {
          "slug": "email",
          "label": "Email",
          "type": "string",
          "required": true,
          "searchable": true,
          "translatable": false
        },
        {
          "slug": "message",
          "label": "Message",
          "type": "text",
          "required": true,
          "searchable": true,
          "translatable": false
        }
      ]
    }
  ]
}
