---
import CopyBlocks from "../components/public/CopyBlocks.astro";
import PageBanner from "../components/public/PageBanner.astro";
import Public from "../layouts/Public.astro";
import { company, email, phone, postalAddress, what3Words } from "../public/contact";
import { copyBlocks, defaultContact, pageCopy } from "../public/copy";
import { publicLocals } from "../public/locals";

const { catalogue } = publicLocals(Astro.locals);
const content = await catalogue.siteContent();
const edited = pageCopy(content, "contact");
const title = edited?.title?.trim() || "Contact";
const blocks = copyBlocks(edited?.body?.trim() || defaultContact);
---

<Public title={title} current="contact" banner="contact">
  <section class="mx-auto grid w-full max-w-[80rem] grid-cols-1 items-start gap-10 px-[clamp(1rem,4vw,2.5rem)] pt-6 pb-[clamp(2.5rem,6vw,4.5rem)] md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-x-16 md:pt-14" aria-labelledby="page-title">
    <div>
      <h1 id="page-title" class="m-0 font-display text-[clamp(1.4rem,2.4vw,2rem)] leading-tight font-bold tracking-[0.04em] uppercase motion-safe:animate-rise">{title}</h1>
      <div class="max-w-[48ch] text-[1.1rem] text-muted motion-safe:animate-rise motion-safe:delay-75 [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:text-ink [&_p]:mt-4">
        <CopyBlocks blocks={blocks} />
      </div>
      <address class="mt-9 grid gap-6 border-t border-line pt-7 font-normal not-italic">
        <p class="m-0 text-base text-ink">
          <span class="mb-1 block text-sm text-muted">Address</span>
          {company}<br />{postalAddress}<br />What3Words {what3Words}
        </p>
        <p class="m-0 text-ink">
          <span class="mb-1 block text-sm text-muted">Phone</span>
          <a class="inline-flex min-h-11 items-center text-[clamp(1.15rem,2vw,1.4rem)] font-semibold" href={`tel:${phone}`}>{phone}</a>
        </p>
        <p class="m-0 text-ink">
          <span class="mb-1 block text-sm text-muted">Email</span>
          <a class="inline-flex min-h-11 items-center text-[clamp(1.15rem,2vw,1.4rem)] font-semibold" href={`mailto:${email}`}>{email}</a>
        </p>
      </address>
    </div>
    <PageBanner name="contact" class="aspect-[16/10] md:aspect-[4/5] max-md:order-first" />
  </section>
</Public>
