---
import LeadForm, { type LeadField } from "../components/public/LeadForm.astro";
import Brochure from "../components/public/brochure/Brochure.astro";
import Public from "../layouts/Public.astro";
import { brochurePage } from "../public/brochure";
import { receiveImportRequest, type LeadView } from "../public/leads";
import { publicLocals } from "../public/locals";

const { catalogue, leadServices } = publicLocals(Astro.locals);

let view: LeadView | undefined;
if (Astro.request.method === "POST") {
  const result = await receiveImportRequest(Astro.request, catalogue, leadServices);
  Astro.response.status = result.status;
  view = result.view;
}

const page = await brochurePage(catalogue, "personal-import", "Personal Import Service");
const fields: LeadField[] = [
  { id: "first-name", label: "First name", type: "text", autocomplete: "given-name" },
  { id: "email", label: "Email", type: "email", autocomplete: "email" },
  { id: "phone", label: "Phone", type: "tel", autocomplete: "tel", optional: true },
  { id: "make", label: "Make", type: "text" },
  { id: "model", label: "Model", type: "text" },
  { id: "year", label: "Year", type: "year" },
  { id: "message", label: "Message", type: "textarea" },
];
---

<Public title={page.title} banner="import">
  <Brochure page="personal-import" {...page} />
  <section id="request-an-import" class="border-t border-line py-[clamp(2.5rem,6vw,4.5rem)]" aria-labelledby="request-an-import-title">
    <div class="mx-auto w-full max-w-[80rem] px-[clamp(1rem,4vw,2.5rem)]">
      <h2 id="request-an-import-title" class="m-0 font-display text-[clamp(0.95rem,1.3vw,1.1rem)] leading-snug font-bold tracking-[0.05em] uppercase">Request a personal import</h2>
      <p class="mt-3 max-w-[60ch]">Tell us the car you are looking for, and we will get back to you as soon as possible.</p>
      <LeadForm
        class="mt-4"
        label="Request a personal import"
        action="/personal-import#request-an-import"
        submitLabel="Send import request"
        confirmation="Your import request has been sent."
        fields={fields}
        siteKey={leadServices.siteKey}
        view={view}
      />
    </div>
  </section>
</Public>
