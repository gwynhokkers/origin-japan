---
import CopyBlocks from "../components/public/CopyBlocks.astro";
import PageBanner from "../components/public/PageBanner.astro";
import Public from "../layouts/Public.astro";
import { copySections, defaultPersonalImport, pageCopy, visibleImportPhotos } from "../public/copy";
import { publicLocals } from "../public/locals";

const { catalogue } = publicLocals(Astro.locals);
const content = await catalogue.siteContent();
const edited = pageCopy(content, "personal-import");
const title = edited?.title?.trim() || "Personal Import Service";
const { intro, sections } = copySections(edited?.body?.trim() || defaultPersonalImport);
const photos = visibleImportPhotos(content.importPhotos);
const heading = "m-0 font-display text-[clamp(0.95rem,1.3vw,1.1rem)] leading-snug font-bold tracking-[0.05em] uppercase";
---

<Public title={title} current="personal-import" banner="import">
  <section class="pt-4">
    <div class="mx-auto w-full max-w-[80rem] px-[clamp(1rem,4vw,2.5rem)]">
      <PageBanner name="import" class="aspect-[16/10] md:aspect-[5/2]" />
      <h1 id="page-title" class="relative -mt-7 inline-block max-w-[calc(100%-1rem)] bg-ground pr-4 pt-3.5 font-display text-[clamp(1.4rem,2.4vw,2rem)] leading-tight font-bold tracking-[0.04em] uppercase md:-mt-[3.25rem] md:pr-7 md:pt-5">{title}</h1>
    </div>
  </section>
  {
    intro.length > 0 && (
      <div class="mx-auto w-full max-w-[65ch] px-[clamp(1rem,4vw,2.5rem)] pt-5 pb-[clamp(2.5rem,6vw,4.5rem)] [&_p]:mb-4 [&_p:first-child]:text-[clamp(1.15rem,1.6vw,1.3rem)]">
        <CopyBlocks blocks={intro.map((text) => ({ kind: "paragraph", text }))} />
      </div>
    )
  }
  {
    sections.length > 0 && (
      <div class="border-t border-line py-[clamp(2.5rem,6vw,4.5rem)]">
        <div class="mx-auto grid w-full max-w-[80rem] grid-cols-1 gap-10 px-[clamp(1rem,4vw,2.5rem)] md:grid-cols-2 md:gap-x-16 md:[&>:last-child:nth-child(odd)]:col-span-full">
          {sections.map((section) => (
            <section class="before:mb-4 before:block before:h-[3px] before:w-10 before:bg-accent before:content-['']">
              <h2 class={heading}>{section.heading}</h2>
              <div class="max-w-[60ch] [&_p]:mt-3">
                <CopyBlocks blocks={section.paragraphs.map((text) => ({ kind: "paragraph", text }))} />
              </div>
            </section>
          ))}
        </div>
      </div>
    )
  }
  {
    photos.length > 0 && (
      <section class="border-t border-line py-[clamp(2.5rem,6vw,4.5rem)]" aria-labelledby="import-photos">
        <div class="mx-auto w-full max-w-[80rem] px-[clamp(1rem,4vw,2.5rem)]">
          <h2 id="import-photos" class:list={[heading, "mb-7"]}>Previous personal imports</h2>
          <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,17rem),1fr))] gap-4 p-0 md:[&>li:first-child]:col-span-2 md:[&>li:first-child]:row-span-2 md:[&>li:only-child]:col-span-full max-md:[&>li:first-child]:col-auto max-md:[&>li:first-child]:row-auto">
            {photos.map((photo) => (
              <li>
                <img src={photo.src} alt={photo.alt} width="900" height="600" loading="lazy" class="aspect-[3/2] h-full w-full rounded bg-surface object-cover" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Public>
