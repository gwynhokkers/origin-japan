---
import Brochure from "../components/public/brochure/Brochure.astro";
import Public from "../layouts/Public.astro";
import { brochurePage } from "../public/brochure";
import { publicLocals } from "../public/locals";

const { catalogue } = publicLocals(Astro.locals);
const page = await brochurePage(catalogue, "personal-import", "Personal Import Service");
---

<Public title={page.title} banner="import">
  <Brochure page="personal-import" {...page} />
</Public>
