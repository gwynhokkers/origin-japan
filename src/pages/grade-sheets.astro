---
import CopyBlocks from "../components/public/CopyBlocks.astro";
import PageBanner from "../components/public/PageBanner.astro";
import Public from "../layouts/Public.astro";
import { copySections, defaultGradeSheets, pageCopy } from "../public/copy";
import { publicLocals } from "../public/locals";

const { catalogue } = publicLocals(Astro.locals);
const content = await catalogue.siteContent();
const edited = pageCopy(content, "grade-sheets");
const title = edited?.title?.trim() || "Grade Sheets";
const { intro, sections } = copySections(edited?.body?.trim() || defaultGradeSheets);
const heading = "m-0 font-display text-[clamp(0.95rem,1.3vw,1.1rem)] leading-snug font-bold tracking-[0.05em] uppercase";
---

<Public title={title} current="grade-sheets" banner="grades">
  <section class="pt-4">
    <div class="mx-auto w-full max-w-[80rem] px-[clamp(1rem,4vw,2.5rem)]">
      <PageBanner name="grades" class="aspect-[16/10] md:aspect-[5/2]" />
      <h1 id="page-title" class="relative -mt-7 inline-block max-w-[calc(100%-1rem)] bg-ground pr-4 pt-3.5 font-display text-[clamp(1.4rem,2.4vw,2rem)] leading-tight font-bold tracking-[0.04em] uppercase md:-mt-[3.25rem] md:pr-7 md:pt-5">{title}</h1>
    </div>
  </section>
  <div class="mx-auto grid w-full max-w-[80rem] grid-cols-1 items-start gap-10 px-[clamp(1rem,4vw,2.5rem)] pt-5 pb-[clamp(2.5rem,6vw,4.5rem)] md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-x-16">
    <article class="[&>section+section]:mt-11 [&_p]:mt-3 [&_p]:max-w-[65ch]">
      {
        intro.length > 0 && (
          <section>
            <CopyBlocks blocks={intro.map((text) => ({ kind: "paragraph", text }))} />
          </section>
        )
      }
      {
        sections.map((section) => (
          <section>
            <h2 class={heading}>{section.heading}</h2>
            <CopyBlocks blocks={section.paragraphs.map((text) => ({ kind: "paragraph", text }))} />
          </section>
        ))
      }
    </article>
    <figure class="m-0 md:sticky md:top-6">
      <img
        src="/images/grade-sheet-v70-1400.jpg"
        alt="A Japanese auction exhibit sheet for a Volvo V70, overall grade 3.5, interior grade C, with damage marked on a plan of the car"
        width="1155"
        height="1400"
        loading="lazy"
        class="h-auto w-full rounded border border-line bg-paper"
      />
      <figcaption class="mt-3 text-sm text-muted">An exhibit sheet for a Volvo V70. The grade, 3.5, is in the box at the top right, with the interior grade, C, below it.</figcaption>
    </figure>
  </div>
</Public>
