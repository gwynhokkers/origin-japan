---
import Brochure from "../components/public/brochure/Brochure.astro";
import Public from "../layouts/Public.astro";
import { brochurePage } from "../public/brochure";
import { publicLocals } from "../public/locals";

const { catalogue } = publicLocals(Astro.locals);
const page = await brochurePage(catalogue, "grade-sheets", "Grade Sheets");
---

<Public title={page.title} current="grade-sheets" banner="grades">
  <Brochure page="grade-sheets" {...page} />
</Public>
