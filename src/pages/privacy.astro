---
import CopyBlocks from "../components/public/CopyBlocks.astro";
import Public from "../layouts/Public.astro";
import { copyBlocks, defaultPrivacy, pageCopy } from "../public/copy";
import { publicLocals } from "../public/locals";

const { catalogue } = publicLocals(Astro.locals);
const content = await catalogue.siteContent();
const edited = pageCopy(content, "privacy");
const title = edited?.title?.trim() || "Privacy";
const blocks = copyBlocks(edited?.body?.trim() || defaultPrivacy);
---

<Public title={title}>
  <div class="mx-auto w-full max-w-[80rem] px-[clamp(1rem,4vw,2.5rem)]">
    <div class="border-b border-line pt-8 pb-5">
      <h1 class="m-0 font-display text-[clamp(1.4rem,2.4vw,2rem)] leading-tight font-bold tracking-[0.04em] uppercase">{title}</h1>
    </div>
    <div class="max-w-[65ch] py-5 pb-[clamp(2.5rem,6vw,4.5rem)] [&_h2]:mt-8 [&_h2]:mb-3 [&_p]:mb-4">
      <CopyBlocks blocks={blocks} />
    </div>
  </div>
</Public>
