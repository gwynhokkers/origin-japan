---
import BrandLockup from "./BrandLockup.astro";
import { company, email, phone, postalAddress } from "../../public/contact";
import { navItems, type NavPage } from "../../public/navigation";

type Props = { current?: NavPage };
const { current } = Astro.props;
const frame = "mx-auto w-full max-w-[80rem] px-[clamp(1rem,4vw,2.5rem)]";
const markLink =
  "brand-mark absolute inset-y-0 left-0 z-10 flex items-center no-underline focus-visible:outline-ink max-lg:px-[clamp(1rem,4vw,2.5rem)] lg:w-[17.5rem] lg:px-4";
const markSpace = "hidden w-[calc(17.5rem-clamp(1rem,4vw,2.5rem))] shrink-0 lg:block";
const contactRow =
  "site-menu-item flex min-h-12 items-center border-b border-line text-base no-underline hover:text-accent";
---

<header class="relative border-t-4 border-b border-t-accent border-b-line">
  <a class={markLink} href="/" aria-label="Origin Japan">
    <BrandLockup class="relative h-14 md:h-16" tone="ground" />
  </a>
  <div class="carbon-band text-[0.8125rem] leading-snug max-lg:hidden">
    <div class:list={[frame, "flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2 lg:flex-nowrap lg:py-2.5"]}>
      <div class={markSpace} aria-hidden="true"></div>
      <div class="flex min-w-0 flex-wrap items-center justify-between gap-x-6 gap-y-1 max-lg:basis-full lg:flex-1 lg:pl-4">
        <p class="m-0 text-[var(--band-muted)]">{company}, {postalAddress}</p>
        <p class="m-0 flex flex-wrap gap-x-5">
          <a class="text-[var(--band-ink)] no-underline hover:underline hover:decoration-accent" href={`tel:${phone}`}>{phone}</a>
          <a class="text-[var(--band-ink)] no-underline hover:underline hover:decoration-accent" href={`mailto:${email}`}>{email}</a>
        </p>
      </div>
    </div>
  </div>
  <div class:list={[frame, "flex min-h-20 items-center md:min-h-[5.5rem] lg:min-h-16 lg:gap-x-6"]}>
    <div class={markSpace} aria-hidden="true"></div>
    <div class="flex min-w-0 flex-1 items-center justify-end max-lg:-mr-2.5 lg:pl-4">
      <nav class="page-nav flex min-w-0 flex-1 justify-end gap-x-1 max-lg:hidden" aria-label="Pages">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={current === item.page ? "page" : undefined}
              class="nav-link inline-flex min-h-11 snap-start items-center px-3 font-display text-[0.66rem] tracking-[0.06em] whitespace-nowrap uppercase aria-[current=page]:font-bold"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <button
        type="button"
        class="theme-toggle inline-flex size-11 shrink-0 cursor-pointer items-center justify-center"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Switch to dark theme"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"></path>
        </svg>
      </button>
      <button
        type="button"
        class="menu-toggle relative inline-flex size-11 shrink-0 items-center justify-center lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Open menu"
      >
        <span class="menu-stroke menu-stroke-top" aria-hidden="true"></span>
        <span class="menu-stroke menu-stroke-bottom" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div id="site-menu" class="site-menu absolute inset-x-0 top-full z-30 lg:hidden" data-site-menu inert>
    <div class="min-h-0 overflow-hidden">
      <div class="site-menu-sheet border-t border-line bg-ground">
        <div class:list={[frame, "flex flex-col gap-10 pt-8 pb-12"]}>
          <nav aria-label="Pages">
            <ul class="m-0 flex list-none flex-col gap-1 p-0">
              {
                navItems.map((item) => (
                  <li class="site-menu-item">
                    <a
                      href={item.href}
                      aria-current={current === item.page ? "page" : undefined}
                      class="nav-link -mx-3 flex min-h-12 items-center px-3 font-display text-[0.8rem] tracking-[0.08em] uppercase [--slab-inset:0.55rem] aria-[current=page]:font-bold"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="flex flex-col">
            <p class="site-menu-item m-0 mb-3 font-display text-[0.62rem] tracking-[0.14em] text-muted uppercase">Get in touch</p>
            <a class={contactRow} href={`tel:${phone}`}>{phone}</a>
            <a class={contactRow} href={`mailto:${email}`}>{email}</a>
            <p class="site-menu-item m-0 mt-5 text-sm leading-relaxed text-muted">
              {company}<br />{postalAddress}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script is:inline>
    (() => {
      const root = document.documentElement;
      const button = document.querySelector("[data-theme-toggle]");
      if (!(button instanceof HTMLButtonElement)) return;

      const system = () => (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      const active = () => (root.dataset.theme === "dark" || root.dataset.theme === "light" ? root.dataset.theme : system());
      const paint = () => {
        const dark = active() === "dark";
        button.setAttribute("aria-pressed", dark ? "true" : "false");
        button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
      };

      button.addEventListener("click", () => {
        const next = active() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
        paint();
      });

      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        if (!root.dataset.theme) paint();
      });
      paint();
    })();

    (() => {
      const root = document.documentElement;
      const button = document.querySelector("[data-menu-toggle]");
      const menu = document.querySelector("[data-site-menu]");
      if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

      menu.querySelectorAll(".site-menu-item").forEach((item, index) => {
        if (item instanceof HTMLElement) item.style.setProperty("--i", String(index));
      });

      const isOpen = () => button.getAttribute("aria-expanded") === "true";
      const set = (open, { restoreFocus = false } = {}) => {
        button.setAttribute("aria-expanded", open ? "true" : "false");
        button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        menu.toggleAttribute("data-open", open);
        menu.inert = !open;
        root.classList.toggle("menu-open", open);
        if (restoreFocus) button.focus();
      };

      button.addEventListener("click", () => set(!isOpen()));
      menu.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) set(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && isOpen()) set(false, { restoreFocus: true });
      });
      window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
        if (event.matches && isOpen()) set(false);
      });
    })();
  </script>
</header>
