---
import type { CopySection, BrochurePage } from "../../../public/copy";
import CopyBlocks from "../CopyBlocks.astro";

type Props = { page: BrochurePage; sections: readonly CopySection[]; nested?: boolean };
const { page, sections, nested = false } = Astro.props;
const heading = "m-0 font-display text-[clamp(0.95rem,1.3vw,1.1rem)] leading-snug font-bold tracking-[0.05em] uppercase";
---

{
  (page === "home" || page === "personal-import") && (
    <div class="border-t border-line py-[clamp(2.5rem,6vw,4.5rem)]">
      <div class="mx-auto grid w-full max-w-[80rem] grid-cols-1 gap-10 px-[clamp(1rem,4vw,2.5rem)] md:grid-cols-2 md:gap-x-16 md:[&>:last-child:nth-child(odd)]:col-span-full">
        {sections.map((section) => (
          <section class="before:mb-4 before:block before:h-[3px] before:w-10 before:bg-accent before:content-['']">
            <h2 class={heading}>{section.heading}</h2>
            <div class="max-w-[60ch] [&_p]:mt-3">
              <CopyBlocks blocks={section.paragraphs.map((text) => ({ kind: "paragraph", text }))} />
            </div>
          </section>
        ))}
      </div>
    </div>
  )
}

{
  page !== "home" && page !== "personal-import" && (
    <div class:list={[
      !nested && "mx-auto w-full px-[clamp(1rem,4vw,2.5rem)]",
      !nested && page !== "contact" && "max-w-[80rem]",
      page === "contact" && "max-w-[48ch] text-[1.1rem] text-muted [&_h2]:text-ink [&_p]:mt-4",
      page === "privacy" && "max-w-[65ch] py-5 [&_p]:mb-4",
      (page === "grade-sheets" || page === "contact" || page === "privacy") && "[&>section+section]:mt-11 [&_h2]:mt-8 [&_h2]:mb-3",
      page === "grade-sheets" && "[&_p]:mt-3 [&_p]:max-w-[65ch]",
    ]}>
      {sections.map((section) => (
        <section>
          <h2 class={heading}>{section.heading}</h2>
          <CopyBlocks blocks={section.paragraphs.map((text) => ({ kind: "paragraph", text }))} />
        </section>
      ))}
    </div>
  )
}
