---
import { sanitizeHref } from "emdash";
import type { BlockImage } from "../../../catalogue";
import { copyParagraphs } from "../../../public/copy";
import { brochurePicture } from "../../../public/photos";
import CopyBlocks from "../CopyBlocks.astro";
import Picture from "../Picture.astro";
import { sectionHeading as headingClass } from "../section-heading";

type Props = {
  heading: string;
  body?: string;
  image?: BlockImage;
  linkLabel?: string;
  linkHref?: string;
};
const { heading, body, image, linkLabel, linkHref } = Astro.props;
const paragraphs = copyParagraphs(body);
const href = linkHref ? sanitizeHref(linkHref) : "";
const showLink = Boolean(linkLabel?.trim() && href && href !== "#");
const src = image?.src.trim() ?? "";
/** The image takes 7 of 12 columns of an 80rem frame from the medium breakpoint. */
const sizes = "(min-width: 1280px) 41.5rem, (min-width: 768px) 52vw, 92vw";
---

<section class="border-t border-line py-[clamp(2.5rem,6vw,4.5rem)]">
  <div
    class:list={[
      "mx-auto grid w-full max-w-[80rem] items-center gap-8 px-[clamp(1rem,4vw,2.5rem)]",
      src && "md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-x-16",
    ]}
  >
    {
      src && (
        <Picture
          picture={brochurePicture(src, sizes)}
          alt={image?.alt?.trim() || ""}
          width={1200}
          height={800}
          class="aspect-[3/2] w-full rounded bg-surface object-cover max-md:order-first"
        />
      )
    }
    <div>
      <h2 class={headingClass}>{heading}</h2>
      {
        paragraphs.length > 0 && (
          <div class="max-w-[46ch] [&_p]:mt-4">
            <CopyBlocks blocks={paragraphs.map((text) => ({ kind: "paragraph", text }))} />
          </div>
        )
      }
      {showLink && (
        <p class="mt-6"><a class="btn-ghost" href={href}>{linkLabel}</a></p>
      )}
    </div>
  </div>
</section>
