---
import { stockHref, type StockSort } from "../../public/vehicles";

type Props = {
  base: "/showroom" | "/sold";
  page: number;
  pages: number;
  sort?: StockSort;
};

const { base, page, pages, sort } = Astro.props;
const link =
  "inline-flex min-h-11 min-w-11 items-center justify-center underline decoration-transparent decoration-2 underline-offset-[0.25em] hover:decoration-accent aria-[current=page]:font-semibold aria-[current=page]:decoration-accent";

function href(number: number): string {
  return stockHref(base, { sort, page: number });
}

const numbers = pageNumbers(page, pages);

function pageNumbers(current: number, total: number): (number | "gap")[] {
  if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);
  const window: (number | "gap")[] = [1];
  if (start > 2) window.push("gap");
  for (let number = start; number <= end; number += 1) window.push(number);
  if (end < total - 1) window.push("gap");
  window.push(total);
  return window;
}
---

{
  pages > 1 && (
    <nav
      class="flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-line pt-4 pb-[clamp(2.5rem,6vw,4.5rem)] text-sm"
      aria-label="Pagination"
    >
      {
        page > 1 && (
          <a class={`${link} px-2`} href={href(page - 1)}>
            Previous
          </a>
        )
      }
      {
        numbers.map((item) =>
          item === "gap" ? (
            <span class="px-1 text-muted" aria-hidden="true">
              …
            </span>
          ) : (
            <a class={link} href={href(item)} aria-current={item === page ? "page" : undefined}>
              {item}
            </a>
          ),
        )
      }
      {
        page < pages && (
          <a class={`${link} px-2`} href={href(page + 1)}>
            Next
          </a>
        )
      }
    </nav>
  )
}
