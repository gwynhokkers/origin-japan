---
import type { LeadView } from "../../public/leads";
import LeadForm, { type LeadField } from "./LeadForm.astro";

type Props = { slug: string; siteKey?: string; view?: LeadView };

const { slug, siteKey, view } = Astro.props;

const fields: LeadField[] = [
  { id: "first-name", label: "First name", type: "text", autocomplete: "given-name" },
  { id: "email", label: "Email", type: "email", autocomplete: "email" },
  { id: "message", label: "Message", type: "textarea" },
];
---

<LeadForm
  class="order-6 mt-4 lg:order-none"
  label="Enquire about this car"
  action={`/listings/${encodeURIComponent(slug)}`}
  submitLabel="Enquire about this car"
  confirmation="Your enquiry has been sent."
  fields={fields}
  siteKey={siteKey}
  view={view}
/>
