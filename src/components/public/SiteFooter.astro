---
import { company, email, phone, postalAddress } from "../../public/contact";

const frame = "mx-auto w-full max-w-[80rem] px-[clamp(1rem,4vw,2.5rem)]";
---

<footer class="border-t border-line bg-surface text-sm">
  <div class:list={[frame, "grid grid-cols-1 gap-6 py-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] md:gap-x-12"]}>
    <div>
      <a class="mb-3 inline-block font-display text-[0.95rem] font-bold tracking-[0.08em] uppercase no-underline" href="/">Origin Japan</a>
      <p class="m-0 mb-1">{company}</p>
      <p class="m-0 mb-1">{postalAddress}</p>
    </div>
    <div>
      <p class="m-0 mb-1"><a class="no-underline hover:underline hover:decoration-accent" href={`tel:${phone}`}>{phone}</a></p>
      <p class="m-0 mb-1"><a class="no-underline hover:underline hover:decoration-accent" href={`mailto:${email}`}>{email}</a></p>
    </div>
    <div>
      <p class="m-0 mb-1"><a class="no-underline hover:underline hover:decoration-accent" href="/sold">Sold Stock</a></p>
      <p class="m-0 mb-1"><a class="no-underline hover:underline hover:decoration-accent" href="/privacy">Privacy</a></p>
    </div>
  </div>
</footer>
