---
import type { BannerName } from "../../public/site-photos";

type Props = { name: BannerName; class?: string };
const { name, class: className = "" } = Astro.props;
---

<div
  class:list={[`banner-${name}`, "rounded bg-cover bg-no-repeat motion-safe:animate-settle", className]}
  aria-hidden="true"
></div>
