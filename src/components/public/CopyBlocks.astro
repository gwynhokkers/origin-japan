---
import type { CopyBlock } from "../../public/copy";
import { sectionHeading as heading } from "./section-heading";

type Props = { blocks: readonly CopyBlock[] };
---

{
  Astro.props.blocks.map((block) =>
    block.kind === "heading" ? <h2 class={heading}>{block.text}</h2> : <p>{block.text}</p>,
  )
}
