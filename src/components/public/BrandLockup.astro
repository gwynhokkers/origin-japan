---
type Props = { class?: string; loading?: "eager" | "lazy" };
const { class: className = "", loading = "eager" } = Astro.props;
---

<img
  width="640"
  height="189"
  loading={loading}
  decoding="async"
  src="/images/origin-japan-lockup.webp"
  alt="Origin Japan"
  class:list={["block w-auto", className]}
/>
