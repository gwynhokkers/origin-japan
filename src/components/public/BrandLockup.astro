---
type Props = { class?: string; loading?: "eager" | "lazy"; tone?: "ground" | "carbon" };
const { class: className = "", loading = "eager", tone = "carbon" } = Astro.props;
const shared = { width: 960, height: 284, loading, decoding: "async" as const };
---

{
  tone === "ground" ? (
    <span class:list={["brand-lockup", className]}>
      <img {...shared} class="brand-lockup-carbon" src="/images/origin-japan-lockup.png" alt="Origin Japan" />
      <img {...shared} class="brand-lockup-ink" src="/images/origin-japan-lockup-ink.png" alt="" />
    </span>
  ) : (
    <img
      {...shared}
      src="/images/origin-japan-lockup.png"
      alt="Origin Japan"
      class:list={["block w-auto", className]}
    />
  )
}
