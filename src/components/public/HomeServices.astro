---
import type { CopySection } from "../../public/copy";
import CopyBlocks from "./CopyBlocks.astro";

type Props = { sections: readonly CopySection[] };
const { sections } = Astro.props;
const [first, ...rest] = sections;
const heading = "m-0 font-display text-[clamp(0.95rem,1.3vw,1.1rem)] leading-snug font-bold tracking-[0.05em] uppercase";
---

{
  first && (
    <section class="border-t border-line py-[clamp(2.5rem,6vw,4.5rem)]" aria-label="What Origin does">
      <div class="mx-auto grid w-full max-w-[80rem] items-center gap-8 px-[clamp(1rem,4vw,2.5rem)] md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-x-16">
        <img
          src="/images/suzuki-carry-sunset-1400.jpg"
          alt="A white Suzuki Carry kei truck at sunset"
          width="1400"
          height="1092"
          loading="lazy"
          class="aspect-[3/2] w-full rounded bg-surface object-cover max-md:order-first"
        />
        <div>
          <h2 class={heading}>{first.heading}</h2>
          <div class="max-w-[46ch] [&_p]:mt-4">
            <CopyBlocks blocks={first.paragraphs.map((text) => ({ kind: "paragraph", text }))} />
          </div>
          {/import/i.test(first.heading) && (
            <p class="mt-6"><a href="/personal-import">Personal Import Service</a></p>
          )}
        </div>
      </div>
      {
        rest.length > 0 && (
          <div class="mx-auto mt-[clamp(2.5rem,6vw,4.5rem)] grid w-full max-w-[80rem] grid-cols-1 gap-10 px-[clamp(1rem,4vw,2.5rem)] md:grid-cols-2 md:gap-x-16 md:[&>:last-child:nth-child(odd)]:col-span-full">
            {rest.map((section) => (
              <section class="before:mb-4 before:block before:h-[3px] before:w-10 before:bg-accent before:content-['']">
                <h2 class={heading}>{section.heading}</h2>
                <div class="max-w-[60ch] [&_p]:mt-3">
                  <CopyBlocks blocks={section.paragraphs.map((text) => ({ kind: "paragraph", text }))} />
                </div>
              </section>
            ))}
          </div>
        )
      }
    </section>
  )
}
