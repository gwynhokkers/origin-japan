---
import "../styles/public.css";
import { homeHero } from "../public/hero";
import { siteNavigation } from "../public/navigation";
import { publicLocals } from "../public/locals";
import { banners, type BannerName } from "../public/site-photos";
import SiteFooter from "../components/public/SiteFooter.astro";
import SiteHeader from "../components/public/SiteHeader.astro";

type Props = { title: string; banner?: BannerName };

const { title, banner } = Astro.props;
const photo = banner && banner !== "home" ? banners[banner] : undefined;
const { catalogue } = publicLocals(Astro.locals);
const nav = siteNavigation(await catalogue.navigation());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/syncopate-700.woff2" as="font" type="font/woff2" crossorigin />
    {
      banner === "home" && (
        <link
          rel="preload"
          as="image"
          href={homeHero.src}
          imagesrcset={homeHero.srcset}
          imagesizes={homeHero.sizes}
          fetchpriority="high"
        />
      )
    }
    {
      photo && (
        <>
          <link rel="preload" as="image" href={`${photo.narrow}.avif`} type="image/avif" media="(max-width: 767px)" />
          <link rel="preload" as="image" href={`${photo.wide}.avif`} type="image/avif" media="(min-width: 768px)" />
        </>
      )
    }
    <style is:inline>
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-delay: 0s !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body class="m-0 bg-ground font-sans text-base leading-relaxed text-ink">
    <SiteHeader items={nav.primary} currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <SiteFooter items={nav.footer} />
  </body>
</html>
